{
  "version": 2,
  "name": "jailex-studios-hub",
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": null,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/overlay",
      "dest": "/overlay.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  }
}
